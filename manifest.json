{
  "manifest_version": 3,
  "name": "치지직 이모티콘 커져라! Hugify!",
  "short_name": "커져라! Hugify!",
  "version": "1.1.2",
  "description": "치지직 이모티콘에 마우스를 올리면 커져서 선명하게 미리 확인합니다.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "커져라! Hugify! 설정",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://chzzk.naver.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chzzk.naver.com/live/*",
        "https://chzzk.naver.com/*"
      ],
      "js": [
        "src/content.js"
      ],
      "css": [
        "src/content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
