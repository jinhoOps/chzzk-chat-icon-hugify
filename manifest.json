{
  "manifest_version": 3,
  "name": "치지직 채팅 아이콘 확대기",
  "short_name": "치지직 아이콘 확대",
  "version": "1.0.0",
  "description": "치지직 방송 채팅창 및 이모티콘 팝업에서 마우스 호버 시 아이콘을 크고 선명하게 미리 확인합니다.",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_popup": "src/popup.html",
    "default_title": "치지직 아이콘 확대기 설정",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://chzzk.naver.com/*"
  ],
  "content_scripts": [
    {
      "matches": [
        "https://chzzk.naver.com/live/*",
        "https://chzzk.naver.com/*"
      ],
      "js": [
        "src/content.js"
      ],
      "css": [
        "src/content.css"
      ],
      "run_at": "document_idle"
    }
  ]
}
